# Set on the server only. Never put this in browser code.
ASSEMBLYAI_API_KEY=
PORT=3000
# Required for a public deployment with live voice.
BATCHRUNNER_PUBLIC_ORIGIN=https://your-batchrunner-host.example
BATCHRUNNER_SESSION_SECRET=replace-with-at-least-32-random-characters
BATCHRUNNER_DEMO_ACCESS_CODE=replace-with-a-private-code-for-judges
BATCHRUNNER_DATA_DIR=./.data/runs
